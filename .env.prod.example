# Config for scripts/supabase-setup.sh prod (copy to .env.prod, which is gitignored).
# Get these from the PROD Supabase project dashboard.
#
# NOTE: this file is sourced ONLY by the bash setup script. Expo does NOT load it.
# The app's runtime vars (EXPO_PUBLIC_SUPABASE_URL/KEY) belong in .env.local /
# EAS env, not here.

# Prod project ref (the subdomain in the dashboard URL / project settings).
PROD_PROJECT_REF=your-prod-project-ref

# Only needed the first time you set the pg_cron Vault secrets (prod already has
# them if it was set up before). Used just to print the SQL to run in the editor.
PROD_PROJECT_URL=https://your-prod-project-ref.supabase.co
PROD_SECRET_KEY=sb_secret_your-prod-secret-key
