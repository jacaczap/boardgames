# Config for scripts/supabase-setup.sh dev (copy to .env.dev, which is gitignored).
# Get these from the DEV Supabase project dashboard — see docs/supabase-dev-setup.md.
#
# NOTE: this file is sourced ONLY by the bash setup script. Expo does NOT load it
# (Expo reads .env / .env.local / .env.<ENV>). The app's runtime vars
# (EXPO_PUBLIC_SUPABASE_URL/KEY) belong in .env.local, not here.

# Dev project ref (the subdomain in the dashboard URL / project settings).
DEV_PROJECT_REF=your-dev-project-ref

# Used to print the pg_cron Vault secret SQL (you run it in the dev SQL editor).
DEV_PROJECT_URL=https://your-dev-project-ref.supabase.co
DEV_SECRET_KEY=sb_secret_your-dev-secret-key
