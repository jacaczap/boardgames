# Template for the per-environment env files. Copy to BOTH (gitignored):
#   cp .env.example .env.dev    # DEV Supabase project
#   cp .env.example .env.prod   # PROD Supabase project (rename DEV_ → PROD_)
#
# Consumers:
#   - scripts/supabase-setup.sh  → the <ENV>_SECRET_KEY (project ref + url are
#     derived from EXPO_PUBLIC_SUPABASE_URL)
#   - app.config.ts (local runs) → the EXPO_PUBLIC_ app runtime vars
# On EAS/Vercel builds the EXPO_PUBLIC_ vars come from platform env vars instead
# (see README "Configure EAS Build environment").

# Backend / setup script — secret key, NEVER an EXPO_PUBLIC var:
DEV_SECRET_KEY=sb_secret_your-secret-key

# App runtime — publishable key, safe for the client (sent on the apikey header):
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-publishable-key
